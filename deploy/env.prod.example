# Copiar a la VM como ~/pfg/.env y completar. El deploy lo excluye del rsync, y rsync no
# borra lo que excluye, asi que el de la VM sobrevive a cada despliegue.
# Secretos: openssl rand -hex 32

# Sin HTTPS el login falla en silencio: con NODE_ENV=production la cookie sale con
# secure=true. SITE_ADDRESS acepta :80 para probar, pero no para entrar.
SITE_ADDRESS=faupersonalucu.duckdns.org
CORS_ORIGIN=https://faupersonalucu.duckdns.org
FRONTEND_URL=https://faupersonalucu.duckdns.org

POSTGRES_USER=pfg_user
POSTGRES_PASSWORD=CAMBIAR
POSTGRES_DB=pfg_database

JWT_SECRET=CAMBIAR
JWT_EXPIRES_IN=4h
MAX_LOGIN_ATTEMPTS=5
LOCK_DURATION_MIN=15
INVITATION_TTL_HOURS=48
RESET_PASSWORD_TTL_HOURS=1

MINIO_ROOT_USER=pfg_minio_user
MINIO_ROOT_PASSWORD=CAMBIAR
MINIO_BUCKET=pfg-documents

# Relleno a proposito: onModuleInit tira si alguna queda vacia, pero no van credenciales
# productivas al servidor. Sin ellas fallan invitaciones y recuperar contraseña.
TENANT_ID=deshabilitado
CLIENT_ID=deshabilitado
CLIENT_SECRET=deshabilitado
MAIL_FROM=noreply@invalido.local
