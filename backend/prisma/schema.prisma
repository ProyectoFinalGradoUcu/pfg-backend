model funcionarios_cursos {
  id               BigInt                       @id @default(autoincrement())
  persona_id       BigInt
  curso_id         BigInt
  numero_orden     String?                      @db.VarChar(50)
  boletin          String?                      @db.VarChar(50)
  fecha_inicio     DateTime?                    @db.Date
  fecha_fin        DateTime?                    @db.Date
  calificacion     String?
