  irpf_mensual    irpf_mensual @relation(fields: [irpf_mensual_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model irpf_mensual {
  id                         BigInt                 @id @default(autoincrement())
  liquidacion_id             BigInt
  persona_id                 BigInt
  ingresos_gravados          Decimal                @db.Decimal(14, 2)
  deduccion_aportes          Decimal                @default(0) @db.Decimal(14, 2)
  deduccion_hijos            Decimal                @default(0) @db.Decimal(14, 2)
  deduccion_conyuge          Decimal                @default(0) @db.Decimal(14, 2)
  deduccion_profesional      Decimal                @default(0) @db.Decimal(14, 2)
  tasa_deduccion_profesional Decimal                @db.Decimal(5, 4)
  total_deducciones          Decimal                @db.Decimal(14, 2)
  base_imponible_neta        Decimal                @db.Decimal(14, 2)
  total_irpf                 Decimal                @db.Decimal(14, 2)
  irpf_detalle_franjas       irpf_detalle_franjas[]
  liquidaciones              liquidaciones          @relation(fields: [liquidacion_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  personas                   personas               @relation(fields: [persona_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([liquidacion_id, persona_id])
}

