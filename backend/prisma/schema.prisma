  cedula               String?   @db.VarChar(20)
  fecha_nacimiento     DateTime? @db.Date
  discapacitado        Boolean   @default(false)
  porcentaje_deduccion Int?      @db.SmallInt
  vigente_desde        DateTime  @db.Date
  vigente_hasta        DateTime? @db.Date
