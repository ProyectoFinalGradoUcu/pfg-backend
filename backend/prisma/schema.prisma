  usuarios         usuarios?                    @relation(fields: [dado_de_baja_por], references: [id], onDelete: NoAction, onUpdate: NoAction)
  personas         personas                     @relation(fields: [persona_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  modulos          funcionarios_modulos_curso[]

  @@unique([persona_id, curso_id])
}

model funcionarios_misiones {
  persona_id                BigInt
  mision_id                 BigInt
