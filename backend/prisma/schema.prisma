generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model acciones {
  id                 BigInt               @id @default(autoincrement())
  nombre             String               @unique @db.VarChar(60)
  descripcion        String?              @db.VarChar(200)
  bitacora_auditoria bitacora_auditoria[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model acreedores {
  id                    BigInt                  @id @default(autoincrement())
  codigo                String                  @unique @db.VarChar(20)
  nombre                String                  @db.VarChar(150)
  prioridad_deficit     Int                     @unique @db.SmallInt
  formato_archivo       String?                 @default("txt") @db.VarChar(10)
  contacto              String?                 @db.VarChar(200)
  activo                Boolean                 @default(true)
  descuentos_personales descuentos_personales[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model aguinaldos {
  id                              BigInt         @id @default(autoincrement())
  persona_id                      BigInt
  anio                            Int            @db.SmallInt
  semestre                        Int            @db.SmallInt
  total_haberes_gravados_semestre Decimal        @db.Decimal(14, 2)
  meses_trabajados                Int            @db.SmallInt
  irpf_aguinaldo                  Decimal        @default(0) @db.Decimal(14, 2)
  liquidacion_id                  BigInt?
  liquidaciones                   liquidaciones? @relation(fields: [liquidacion_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  personas                        personas       @relation(fields: [persona_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([persona_id, anio, semestre])
}

model ascensos {
  id            BigInt    @id @default(autoincrement())
  persona_id    BigInt?
  grado_id      BigInt?
  fecha_ascenso DateTime? @db.Date
  observaciones String?
  grados        grados?   @relation(fields: [grado_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  personas      personas? @relation(fields: [persona_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model asignaciones_funcionario {
  id               BigInt    @id @default(autoincrement())
  persona_id       BigInt?
  destino_id       BigInt?
  fecha_inicio     DateTime? @db.Date
  fecha_fin        DateTime? @db.Date
  posicion_destino String?   @db.VarChar(200)
  observaciones    String?
  destinos         destinos? @relation(fields: [destino_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  personas         personas? @relation(fields: [persona_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model bancos {
  id                BigInt              @id @default(autoincrement())
  codigo            String              @unique @db.VarChar(20)
  nombre            String              @db.VarChar(100)
  vigente           Boolean             @default(true)
  cuentas_bancarias cuentas_bancarias[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model beneficios_sociales {
  id                       BigInt          @id @default(autoincrement())
  persona_id               BigInt
  tipo_beneficio_id        BigInt
  cantidad                 Int             @default(1) @db.SmallInt
  vigente_desde            DateTime        @db.Date
  vigente_hasta            DateTime?       @db.Date
  estado                   String          @default("activo") @db.VarChar(20)
  documento_respaldo       String?         @db.VarChar(200)
  observaciones            String?
  creado_en                DateTime        @default(now()) @db.Timestamp(6)
  creado_por               BigInt?
  fecha_evento             DateTime?       @db.Date
  clave_evento             String?         @db.VarChar(80)
  retroactividad_pendiente Boolean         @default(false)
  usuarios                 usuarios?       @relation(fields: [creado_por], references: [id], onDelete: NoAction, onUpdate: NoAction)
  personas                 personas        @relation(fields: [persona_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tipos_beneficio          tipos_beneficio @relation(fields: [tipo_beneficio_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([persona_id, estado], map: "idx_beneficios_persona")
  @@index([persona_id, tipo_beneficio_id, clave_evento], map: "idx_beneficios_persona_tipo_clave")
  @@index([retroactividad_pendiente], map: "idx_beneficios_retro_pendiente")
  @@index([tipo_beneficio_id, estado], map: "idx_beneficios_tipo_estado")
}

model bitacora_auditoria {
  id          BigInt    @id @default(autoincrement())
  usuario_id  BigInt
  accion_id   BigInt
  contexto_id BigInt
  host        String?   @db.VarChar(100)
  fecha       DateTime  @default(now()) @db.Timestamp(6)
  entidad     String?   @db.VarChar(60)
  entidad_id  BigInt?
  detalle     Json?
  acciones    acciones  @relation(fields: [accion_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contextos   contextos @relation(fields: [contexto_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuarios    usuarios  @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model catalogo_items {
  id                    BigInt                  @id @default(autoincrement())
  codigo                Int                     @unique
  nombre                String                  @db.VarChar(150)
  tipo                  String                  @db.VarChar(30)
  es_grabado            Boolean                 @default(true)
  contribuye_w_para_5_3 Boolean                 @default(false)
  contribuye_w_para_10  Boolean                 @default(false)
  contribuye_w_para_20  Boolean                 @default(false)
  clasificacion_siif    String?                 @db.VarChar(20)
  formula_calculo       String?                 @db.VarChar(50)
  orden_calculo         Int                     @default(0) @db.SmallInt
  item_par_ficto_id     BigInt?
  vigente               Boolean                 @default(true)
  catalogo_items        catalogo_items?         @relation("catalogo_itemsTocatalogo_items", fields: [item_par_ficto_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_catalogo_items  catalogo_items[]        @relation("catalogo_itemsTocatalogo_items")
  config_compensaciones config_compensaciones[]
  items_liquidacion     items_liquidacion[]
  remuneraciones_grado  remuneraciones_grado[]
  tarifas_por_categoria tarifas_por_categoria[]
  tipos_beneficio       tipos_beneficio[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model cierres {
  id             BigInt        @id @default(autoincrement())
  liquidacion_id BigInt        @unique
  tipo           String        @default("mensual") @db.VarChar(20)
  estado         String        @default("en_proceso") @db.VarChar(20)
  fecha_cierre   DateTime      @default(now()) @db.Timestamp(6)
  cerrado_por    BigInt
  hash_datos     String?       @db.VarChar(128)
  observaciones  String?
  usuarios       usuarios      @relation(fields: [cerrado_por], references: [id], onDelete: NoAction, onUpdate: NoAction)
  liquidaciones  liquidaciones @relation(fields: [liquidacion_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model compa_ia {
  id                   BigInt                 @id @default(autoincrement())
  codigo               String                 @unique @db.VarChar(30)
  denominacion         String                 @db.VarChar(100)
  vigente              Boolean                @default(true)
  relaciones_laborales relaciones_laborales[]

  @@map("compañia")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model config_compensaciones {
  id                   BigInt             @id @default(autoincrement())
  tipo_compensacion_id BigInt
  regimen_id           BigInt?
  grado_id             BigInt?
  unidad_medida        String             @db.VarChar(10)
  formula              String             @db.VarChar(30)
  valor_por_unidad     Decimal?           @db.Decimal(14, 2)
  monto                Decimal?           @db.Decimal(14, 2)
  tope                 Decimal?           @db.Decimal(14, 2)
  vigente_desde        DateTime           @db.Date
  vigente_hasta        DateTime?          @db.Date
  activo               Boolean            @default(true)
  escalafon_id         BigInt?
  funcion              String?            @db.VarChar(50)
  tope_unidades        Int?               @db.SmallInt
  valor_minimo         Decimal?           @db.Decimal(14, 2)
  valor_maximo         Decimal?           @db.Decimal(14, 2)
  sujeto_desc_legales  Boolean            @default(false)
  catalogo_item_id     BigInt?
  catalogo_items       catalogo_items?    @relation(fields: [catalogo_item_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  escalafones          escalafones?       @relation(fields: [escalafon_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  grados               grados?            @relation(fields: [grado_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  regimenes            regimenes?         @relation(fields: [regimen_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tipos_compensacion   tipos_compensacion @relation(fields: [tipo_compensacion_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model contextos {
  id                 BigInt               @id @default(autoincrement())
  nombre             String               @unique @db.VarChar(60)
  descripcion        String?              @db.VarChar(200)
  bitacora_auditoria bitacora_auditoria[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model cuentas_bancarias {
  id            BigInt   @id @default(autoincrement())
