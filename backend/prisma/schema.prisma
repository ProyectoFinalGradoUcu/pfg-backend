}

model escalafones {
  id                    BigInt                  @id @default(autoincrement())
  codigo                String                  @unique @db.VarChar(30)
  denominacion          String                  @db.VarChar(100)
  vigente               Boolean                 @default(true)
  config_compensaciones config_compensaciones[]
