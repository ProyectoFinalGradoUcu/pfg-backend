  reglas_ascenso_reglas_ascenso_grado_origen_idTogrados                                      reglas_ascenso?                     @relation("reglas_ascenso_grado_origen_idTogrados")
  relaciones_laborales                                                                       relaciones_laborales[]
  relaciones_laborales_relaciones_laborales_grado_reincorporacion_idTogrados                 relaciones_laborales[]              @relation("relaciones_laborales_grado_reincorporacion_idTogrados")
  remuneraciones_grado                                                                       remuneraciones_grado[]
}

model irpf_detalle_franjas {
