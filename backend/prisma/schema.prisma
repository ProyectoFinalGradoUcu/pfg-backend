  banco_id      BigInt
  numero_cuenta String?  @db.VarChar(50)
  estado        String   @db.VarChar(20)
  bancos        bancos   @relation(fields: [banco_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  personas      personas @relation(fields: [persona_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model cursos {
  id                  BigInt                @id @default(autoincrement())
  nombre_curso        String?               @db.VarChar(200)
  institucion         String?               @db.VarChar(200)
  boletin             String?               @db.VarChar(50)
  numero_orden        String?               @db.VarChar(50)
  funcionarios_cursos funcionarios_cursos[]
  modulos_curso       modulos_curso[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model dependientes {
  id                   BigInt    @id @default(autoincrement())
  persona_id           BigInt
  tipo                 String    @db.VarChar(30)
  nombre               String    @db.VarChar(100)
  cedula               String?   @db.VarChar(20)
  fecha_nacimiento     DateTime? @db.Date
  discapacitado        Boolean   @default(false)
  porcentaje_deduccion Int?      @db.SmallInt
  vigente_desde        DateTime  @db.Date
  vigente_hasta        DateTime? @db.Date
  activo               Boolean   @default(true)
  personas             personas  @relation(fields: [persona_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([persona_id, activo], map: "ix_dependientes_persona_activo")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model descuentos_personales {
  id                  BigInt         @id @default(autoincrement())
  persona_id          BigInt
  acreedor_id         BigInt
  liquidacion_id      BigInt?
  tipo                String         @db.VarChar(20)
  monto_solicitado    Decimal        @db.Decimal(14, 2)
  monto_aplicado      Decimal?       @db.Decimal(14, 2)
  estado              String         @default("pendiente") @db.VarChar(20)
  periodo_anio        Int            @db.SmallInt
  periodo_mes         Int            @db.SmallInt
  fecha_importacion   DateTime       @default(now()) @db.Timestamp(6)
  archivo_origen      String?        @db.VarChar(200)
  enviada_acreedor_en DateTime?      @db.Timestamp(6)
  observaciones       String?
  acreedores          acreedores     @relation(fields: [acreedor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  liquidaciones       liquidaciones? @relation(fields: [liquidacion_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  personas            personas       @relation(fields: [persona_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([acreedor_id, periodo_anio, periodo_mes], map: "idx_descuentos_acreedor")
  @@index([estado], map: "idx_descuentos_estado")
  @@index([persona_id, periodo_anio, periodo_mes], map: "idx_descuentos_persona")
}

model destinos {
  id                       BigInt                     @id @default(autoincrement())
  ubicacion                String?                    @db.VarChar(200)
  numero_orden             String?                    @db.VarChar(50)
  tipo_destino             String?                    @db.VarChar(100)
