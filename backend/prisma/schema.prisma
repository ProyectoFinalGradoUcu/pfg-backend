  personas                  personas @relation(fields: [persona_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([persona_id, mision_id])
}

model funcionarios_modulos_curso {
  id                   BigInt              @id @default(autoincrement())
  funcionario_curso_id BigInt
  modulo_id            BigInt
  numero_orden         String?             @db.VarChar(50)
