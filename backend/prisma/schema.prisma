  modulos_curso        modulos_curso       @relation(fields: [modulo_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([funcionario_curso_id, modulo_id])
}

model funcionarios_vuelos {
  persona_id BigInt
  vuelo_id   BigInt
  personas   personas @relation(fields: [persona_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vuelos     vuelos   @relation(fields: [vuelo_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([persona_id, vuelo_id])
}

model grados {
  id                                                                                         BigInt                              @id @default(autoincrement())
