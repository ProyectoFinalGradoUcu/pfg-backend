generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model person {
  person_id    Int      @id @default(autoincrement())
  national_id  String   @unique @db.VarChar(50)
  first_name   String?  @db.VarChar(100)
  last_name    String?  @db.VarChar(100)
  birth_date   DateTime? @db.Date
  birth_place  String?  @db.VarChar(200)
  gender       String?  @db.VarChar(20)
  ethnicity    String?  @db.VarChar(50)
  marital_status String? @db.VarChar(50)
  address      String?  @db.VarChar(255)
  postal_code  String?  @db.VarChar(20)
  sectional    String?  @db.VarChar(100)
  email        String?  @db.VarChar(150)
  photo        Bytes?
  death_date   DateTime? @db.Date
  is_civil     Boolean? @default(false)
  staff        staff?
  family_relation_person    family_relation[] @relation("person_to_family_relation")
  family_relation_relative  family_relation[] @relation("relative_to_family_relation")
  housing_occupancy         housing_occupancy[]
}

model category {
  category_id   Int      @id @default(autoincrement())
  category_name String?  @db.VarChar(100)
  staff         staff[]
  category_rank category_rank[]
}

model rank {
  rank_id       Int      @id @default(autoincrement())
  rank_name     String?  @db.VarChar(100)
  category_rank category_rank[]
}

model category_rank {
  category_id Int
  rank_id     Int
  category    category @relation(fields: [category_id], references: [category_id])
  rank        rank     @relation(fields: [rank_id], references: [rank_id])
  promotion   promotion[]

  @@id([category_id, rank_id])
}

model staff {
  person_id        Int              @id
  category_id      Int
  staff_type       staff_type_enum?
  command_right    Boolean?
  rank_position    Int?
  discharge_reason String?
  discharge_date   DateTime?        @db.Date
  mutations        String?
  conduct          String?
  person           person           @relation(fields: [person_id], references: [person_id], onDelete: Cascade)
  category         category         @relation(fields: [category_id], references: [category_id])
  retirement       retirement?
  staff_assignment staff_assignment[]
  staff_mission    staff_mission[]
  staff_flight     staff_flight[]
  staff_course     staff_course[]
  promotion        promotion[]
}

model mission {
  mission_id          Int      @id @default(autoincrement())
  country             String?  @db.VarChar(100)
  mission_type        String?  @db.VarChar(100)
  departure_date      DateTime? @db.Date
  arrival_date        DateTime? @db.Date
  order_number        String?  @db.VarChar(50)
  bulletin            String?  @db.VarChar(50)
  observations        String?
  responsible_command String?  @db.VarChar(200)
  staff_mission       staff_mission[]
}

model destination {
  destination_id   Int      @id @default(autoincrement())
  location         String?  @db.VarChar(200)
  order_number     String?  @db.VarChar(50)
  destination_type String?  @db.VarChar(100)
  staff_assignment staff_assignment[]
}

model flight {
  flight_id              Int       @id @default(autoincrement())
  year                   Int?
  quarter                Int?
  aircraft_type          String?   @db.VarChar(100)
  aircraft_model         String?   @db.VarChar(100)
  function               String?   @db.VarChar(100)
  flight_hours           Decimal?  @db.Decimal(10, 2)
  fictional_flight_hours Decimal?  @db.Decimal(10, 2)
  total_hours            Decimal?  @db.Decimal(10, 2)
  license_type           String?   @db.VarChar(100)
  license_date           DateTime? @db.Date
  staff_flight           staff_flight[]
}

model course {
  course_id    Int       @id @default(autoincrement())
  course_name  String?   @db.VarChar(200)
  institution  String?   @db.VarChar(200)
  start_date   DateTime? @db.Date
  end_date     DateTime? @db.Date
  bulletin     String?   @db.VarChar(50)
  order_number String?   @db.VarChar(50)
  staff_course staff_course[]
}

model service_housing {
  housing_id        Int      @id @default(autoincrement())
  address           String?  @db.VarChar(255)
  housing_occupancy housing_occupancy[]
}

model retirement {
  retirement_id   Int       @id @default(autoincrement())
  person_id       Int       @unique
  retirement_date DateTime? @db.Date
  retirement_time DateTime? @db.Time
  reason          String?
  staff           staff     @relation(fields: [person_id], references: [person_id])
}

model family_relation {
  person_id     Int
  relative_id   Int
  relation_type String?  @db.VarChar(50)
  observations  String?
  person        person   @relation("person_to_family_relation", fields: [person_id], references: [person_id])
  relative      person   @relation("relative_to_family_relation", fields: [relative_id], references: [person_id])

  @@id([person_id, relative_id])
}

model staff_assignment {
  assignment_id  Int       @id @default(autoincrement())
  person_id      Int
  destination_id Int
  start_date     DateTime? @db.Date
  end_date       DateTime? @db.Date
  observations   String?
  staff          staff     @relation(fields: [person_id], references: [person_id])
  destination    destination @relation(fields: [destination_id], references: [destination_id])
}

model staff_mission {
  person_id  Int
  mission_id Int
  staff      staff   @relation(fields: [person_id], references: [person_id])
  mission    mission @relation(fields: [mission_id], references: [mission_id])

  @@id([person_id, mission_id])
}

model staff_flight {
  person_id Int
  flight_id Int
  staff     staff  @relation(fields: [person_id], references: [person_id])
  flight    flight @relation(fields: [flight_id], references: [flight_id])

  @@id([person_id, flight_id])
}

model staff_course {
  person_id Int
  course_id Int
  staff     staff  @relation(fields: [person_id], references: [person_id])
  course    course @relation(fields: [course_id], references: [course_id])

  @@id([person_id, course_id])
}

model promotion {
  promotion_id  Int       @id @default(autoincrement())
  person_id     Int
  category_id   Int
  rank_id       Int
  promotion_date DateTime? @db.Date
  observations  String?
  staff         staff     @relation(fields: [person_id], references: [person_id])
  category_rank category_rank @relation(fields: [category_id, rank_id], references: [category_id, rank_id])
}

model housing_occupancy {
  person_id  Int
  housing_id Int
  start_date DateTime
  end_date   DateTime?
  person     person          @relation(fields: [person_id], references: [person_id])
  housing    service_housing @relation(fields: [housing_id], references: [housing_id])

  @@id([person_id, housing_id])
}

model audit_log {
  id          BigInt    @id @default(autoincrement())
  changed_at  DateTime  @default(now()) @db.Timestamptz()
  table_name  String
  primary_key String
  user_id     String?
  operation   String
  column_name String?
  old_value   String?
  new_value   String?
  notes       String?
}

enum staff_type_enum {
  subaltern
  official
}

